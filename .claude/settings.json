{
  "permissions": {
    "allow": [
      "Bash(npm run check)",
      "Bash(npm run test)",
      "Bash(npm run test:*)",
      "Bash(npm run lint)",
      "Bash(npm run build)",
      "Bash(npm run q)",
      "Bash(npm run q -- find:*)",
      "Bash(npm run q -- search:*)",
      "Bash(npm run q -- show:*)",
      "Bash(npm run q -- wiki:*)",
      "Bash(npm run q -- check:*)",
      "Bash(npm run q -- review:*)",
      "Bash(npm run q -- count)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format.mjs\"",
            "timeout": 30,
            "statusMessage": "Prettier"
          }
        ]
      }
    ]
  }
}
